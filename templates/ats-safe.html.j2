<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>{{ cv.name }} - Resume</title>
<style>
  @page { size: A4; margin: 16mm 18mm; }
  * { box-sizing: border-box; }
  body {
    font-family: Arial, Helvetica, sans-serif;
    color: #000;
    font-size: 11pt;
    line-height: 1.55;
    margin: 0;
    padding: 24px 32px;
    max-width: 800px;
  }
  h1 { font-size: 21pt; margin: 0 0 4px 0; }
  .headline { font-size: 12pt; color: #333; margin: 0 0 8px 0; }
  .contact { font-size: 10pt; color: #333; margin: 0 0 16px 0; }
  .contact span:not(:last-child)::after { content: " | "; color: #999; }
  h2 {
    font-size: 12pt;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    border-bottom: 1px solid #000;
    padding-bottom: 3px;
    margin: 28px 0 12px 0;
  }
  h2:first-of-type { margin-top: 20px; }
  .entry { margin-bottom: 14px; break-inside: avoid; }
  .entry + .entry { border-top: 1px dotted #aaa; padding-top: 12px; }
  .entry-header { font-weight: bold; font-size: 11.5pt; }
  .entry-sub { font-size: 10.5pt; color: #555; margin-bottom: 4px; }
  .position-block { margin-top: 10px; margin-left: 18px; break-inside: avoid; }
  .position-block:first-of-type { margin-top: 4px; }
  .position-block + .position-block { border-top: 1px solid #e2e2e2; padding-top: 8px; }
  .position-header { font-weight: bold; font-size: 11pt; }
  .position-sub { font-size: 10pt; color: #777; margin-bottom: 4px; }
  .entry-header-dates { font-weight: normal; font-size: 10pt; color: #666; }
  ul { margin: 4px 0 0 0; padding-left: 18px; }
  li { margin-bottom: 4px; }
  p { margin: 0 0 8px 0; }
  .skills-row { margin-bottom: 5px; }
  .skills-label { font-weight: bold; }

  @media screen {
    html { background: #e9e9e9; }
    body {
      margin: 32px auto;
      background: #fff;
      box-shadow: 0 0 14px rgba(0, 0, 0, 0.15);
    }
  }
</style>
</head>
<body>
  <h1>{{ cv.name }}</h1>
  {% if cv.headline %}<div class="headline">{{ cv.headline }}</div>{% endif %}
  <div class="contact">
    {% if cv.location %}<span>{{ cv.location }}</span>{% endif %}
    {% if cv.email %}<span>{{ cv.email }}</span>{% endif %}
    {% if cv.website %}<span>{{ cv.website }}</span>{% endif %}
    {% for net in cv.social_networks %}<span><strong>{{ net.network }}:</strong> {{ net.username }}</span>{% endfor %}
  </div>

  {% if cv.sections.summary %}
  <h2>Summary</h2>
  {% for para in cv.sections.summary %}
  <p>{{ para | md_bold | safe }}</p>
  {% endfor %}
  {% endif %}

  {% if cv.sections.experience %}
  <h2>Experience</h2>
  {% for job in cv.sections.experience %}
  <div class="entry">
    {% if job.positions | length == 1 %}
    {% set pos = job.positions[0] %}
    <div class="entry-header">{{ pos.position }}, {{ job.company }}</div>
    <div class="entry-sub">{{ job.location }} &nbsp;|&nbsp; {{ (pos.start_date, pos.end_date) | date_range }}</div>
    <ul>
      {% for h in pos.highlights %}
      <li>{{ h | md_bold | safe }}</li>
      {% endfor %}
    </ul>
    {% else %}
    <div class="entry-header">{{ job.company }} <span class="entry-header-dates">({{ (job.positions[-1].start_date, job.positions[0].end_date) | date_range }})</span></div>
    <div class="entry-sub">{{ job.location }}</div>
    {% for pos in job.positions %}
    <div class="position-block">
      <div class="position-header">{{ pos.position }}</div>
      <div class="position-sub">{{ (pos.start_date, pos.end_date) | date_range }}</div>
      <ul>
        {% for h in pos.highlights %}
        <li>{{ h | md_bold | safe }}</li>
        {% endfor %}
      </ul>
    </div>
    {% endfor %}
    {% endif %}
  </div>
  {% endfor %}
  {% endif %}

  {% if cv.sections.education %}
  <h2>Education</h2>
  {% for ed in cv.sections.education %}
  <div class="entry">
    <div class="entry-header">{{ ed.institution }}</div>
    <div class="entry-sub">{{ ed.degree }}, {{ ed.area }} &nbsp;|&nbsp; {{ ed.location }} &nbsp;|&nbsp; {{ (ed.start_date, ed.end_date) | date_range }}</div>
  </div>
  {% endfor %}
  {% endif %}

  {% if cv.sections.skills %}
  <h2>Skills</h2>
  {% for s in cv.sections.skills %}
  <div class="skills-row"><span class="skills-label">{{ s.label }}:</span> {{ s.details }}</div>
  {% endfor %}
  {% endif %}

  {% if cv.sections.awards %}
  <h2>Awards</h2>
  <ul>
    {% for a in cv.sections.awards %}
    <li>{{ a.bullet | md_bold | safe }}</li>
    {% endfor %}
  </ul>
  {% endif %}
</body>
</html>
