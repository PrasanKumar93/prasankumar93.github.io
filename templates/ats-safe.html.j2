<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>{{ cv.name }} - Resume</title>
<style>
  @page { size: A4; margin: 16mm 18mm; }
  * { box-sizing: border-box; }
  body {
    font-family: Arial, Helvetica, sans-serif;
    color: #000;
    font-size: 11pt;
    line-height: 1.45;
    margin: 0;
    padding: 24px 32px;
    max-width: 800px;
  }
  h1 { font-size: 20pt; margin: 0 0 4px 0; }
  .headline { font-size: 12pt; margin: 0 0 8px 0; }
  .contact { font-size: 10pt; margin: 0 0 16px 0; }
  .contact span:not(:last-child)::after { content: " | "; }
  h2 {
    font-size: 12pt;
    text-transform: uppercase;
    border-bottom: 1px solid #000;
    padding-bottom: 2px;
    margin: 18px 0 8px 0;
  }
  .entry { margin-bottom: 10px; break-inside: avoid; }
  .entry-header { font-weight: bold; }
  .entry-sub { font-size: 10.5pt; margin-bottom: 2px; }
  ul { margin: 4px 0 0 0; padding-left: 18px; }
  li { margin-bottom: 3px; }
  p { margin: 0 0 8px 0; }
  .skills-row { margin-bottom: 4px; }
  .skills-label { font-weight: bold; }
</style>
</head>
<body>
  <h1>{{ cv.name }}</h1>
  {% if cv.headline %}<div class="headline">{{ cv.headline }}</div>{% endif %}
  <div class="contact">
    {% if cv.location %}<span>{{ cv.location }}</span>{% endif %}
    {% if cv.email %}<span>{{ cv.email }}</span>{% endif %}
    {% if cv.website %}<span>{{ cv.website }}</span>{% endif %}
    {% for net in cv.social_networks %}<span>{{ net.network }}: {{ net.username }}</span>{% endfor %}
  </div>

  {% if cv.sections.summary %}
  <h2>Summary</h2>
  {% for para in cv.sections.summary %}
  <p>{{ para | md_bold | safe }}</p>
  {% endfor %}
  {% endif %}

  {% if cv.sections.experience %}
  <h2>Experience</h2>
  {% for job in cv.sections.experience %}
  <div class="entry">
    <div class="entry-header">{{ job.position }}, {{ job.company }}</div>
    <div class="entry-sub">{{ job.location }} &nbsp;|&nbsp; {{ (job.start_date, job.end_date) | date_range }}</div>
    <ul>
      {% for h in job.highlights %}
      <li>{{ h | md_bold | safe }}</li>
      {% endfor %}
    </ul>
  </div>
  {% endfor %}
  {% endif %}

  {% if cv.sections.education %}
  <h2>Education</h2>
  {% for ed in cv.sections.education %}
  <div class="entry">
    <div class="entry-header">{{ ed.institution }}</div>
    <div class="entry-sub">{{ ed.degree }}, {{ ed.area }} &nbsp;|&nbsp; {{ ed.location }} &nbsp;|&nbsp; {{ (ed.start_date, ed.end_date) | date_range }}</div>
  </div>
  {% endfor %}
  {% endif %}

  {% if cv.sections.skills %}
  <h2>Skills</h2>
  {% for s in cv.sections.skills %}
  <div class="skills-row"><span class="skills-label">{{ s.label }}:</span> {{ s.details }}</div>
  {% endfor %}
  {% endif %}

  {% if cv.sections.awards %}
  <h2>Awards</h2>
  <ul>
    {% for a in cv.sections.awards %}
    <li>{{ a.bullet | md_bold | safe }}</li>
    {% endfor %}
  </ul>
  {% endif %}
</body>
</html>
