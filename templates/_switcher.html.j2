{% set dock_offset = dock_offset|default('524px') %}
{% set dock_breakpoint = dock_breakpoint|default('1150px') %}
<style>
  .tpl-dock { display: none; }
  @media screen {
    .tpl-dock {
      display: flex;
      flex-direction: column;
      gap: 10px;
      position: fixed;
      top: 40px;
      left: max(12px, calc(50% - {{ dock_offset }}));
      width: 108px;
      z-index: 10;
    }
    .tpl-dock-group {
      background: #fff;
      border: 1px solid #d8d8d8;
      border-radius: 8px;
      padding: 8px;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .tpl-dock-label {
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: #999;
      padding: 0 2px 2px;
    }
    .tpl-dock-btn {
      display: block;
      text-decoration: none;
      font-family: Arial, Helvetica, sans-serif;
      font-size: 11.5px;
      line-height: 1.3;
      padding: 6px 8px;
      border-radius: 6px;
      border: 1px solid #d8d8d8;
      color: #333;
      text-align: center;
    }
    .tpl-dock-btn.active {
      background: #5a5a5a;
      border-color: #5a5a5a;
      color: #fff;
      font-weight: bold;
    }
    .tpl-dock-download {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      text-decoration: none;
      background: #5a5a5a;
      color: #fff;
      font-family: Arial, Helvetica, sans-serif;
      font-size: 12px;
      font-weight: bold;
      padding: 9px 8px;
      border-radius: 8px;
    }
    @media (max-width: {{ dock_breakpoint }}) {
      .tpl-dock {
        position: static;
        flex-direction: row;
        align-items: center;
        width: auto;
        max-width: 800px;
        margin: 0 auto 16px auto;
        left: auto;
        top: auto;
      }
      .tpl-dock-group {
        flex-direction: row;
      }
      .tpl-dock-download {
        padding: 9px 14px;
      }
    }
  }
</style>
<nav class="tpl-dock" aria-label="Resume template switcher">
  <div class="tpl-dock-group">
    {% for tpl in templates %}
    <a class="tpl-dock-btn{% if tpl.id == current_id %} active{% endif %}"
       href="{{ root_prefix }}{{ tpl.url }}"{% if tpl.id == current_id %} aria-current="page"{% endif %}>{{ tpl.short }}</a>
    {% endfor %}
  </div>
  <a class="tpl-dock-download" href="{{ root_prefix }}{{ current_id }}/resume.pdf" download="prasan-rajpurohit-resume-{{ build_date }}.pdf">&darr; PDF</a>
</nav>
