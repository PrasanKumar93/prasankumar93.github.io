<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>{{ cv.name }} - Resume</title>
<style>
  @page { size: A4; margin: 20mm 22mm; }
  * { box-sizing: border-box; }
  body {
    font-family: 'Georgia', 'Times New Roman', serif;
    color: #1a1a1a;
    font-size: 10.5pt;
    line-height: 1.55;
    margin: 0;
    padding: 40px 48px;
    max-width: 760px;
  }
  header { margin-bottom: 22px; }
  h1 {
    font-family: 'Helvetica Neue', Arial, sans-serif;
    font-weight: 300;
    font-size: 30pt;
    letter-spacing: 0.5px;
    margin: 0 0 6px 0;
    color: #111;
  }
  .headline {
    font-family: 'Helvetica Neue', Arial, sans-serif;
    font-size: 11.5pt;
    color: #555;
    margin: 0 0 14px 0;
  }
  .contact {
    font-family: 'Helvetica Neue', Arial, sans-serif;
    font-size: 9.5pt;
    color: #666;
    letter-spacing: 0.3px;
  }
  .contact span { margin-right: 14px; }
  hr.divider {
    border: none;
    border-top: 1px solid #ddd;
    margin: 18px 0 22px 0;
  }
  h2 {
    font-family: 'Helvetica Neue', Arial, sans-serif;
    font-size: 10pt;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: #888;
    margin: 26px 0 12px 0;
  }
  h2:first-of-type { margin-top: 0; }
  .summary { color: #333; margin: 0; }
  .entry {
    margin-bottom: 16px;
    break-inside: avoid;
    display: flex;
    flex-direction: column;
  }
  .entry-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }
  .entry-title {
    font-family: 'Helvetica Neue', Arial, sans-serif;
    font-weight: 600;
    font-size: 11pt;
    color: #111;
  }
  .entry-company {
    font-style: italic;
    color: #444;
  }
  .entry-dates {
    font-family: 'Helvetica Neue', Arial, sans-serif;
    font-size: 9.5pt;
    color: #999;
    white-space: nowrap;
    padding-left: 12px;
  }
  .entry-location {
    font-family: 'Helvetica Neue', Arial, sans-serif;
    font-size: 9.5pt;
    color: #999;
    margin-bottom: 6px;
  }
  ul { margin: 0; padding-left: 18px; color: #333; }
  li { margin-bottom: 4px; }
  .position-block { margin-top: 8px; margin-left: 18px; break-inside: avoid; }
  .position-block:first-of-type { margin-top: 2px; }
  .position-block + .position-block { border-top: 1px solid #eee; padding-top: 8px; }
  .position-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }
  .position-title {
    font-family: 'Helvetica Neue', Arial, sans-serif;
    font-weight: 600;
    font-size: 10.2pt;
    color: #222;
  }
  .position-dates {
    font-family: 'Helvetica Neue', Arial, sans-serif;
    font-size: 9pt;
    color: #999;
    white-space: nowrap;
    padding-left: 12px;
  }
  .skills { display: flex; flex-direction: column; gap: 5px; }
  .skills-row {
    display: flex;
  }
  .skills-label {
    font-family: 'Helvetica Neue', Arial, sans-serif;
    font-weight: 600;
    color: #111;
    width: 150px;
    flex-shrink: 0;
  }
  .skills-details { color: #444; }
  .awards-list { margin: 0; padding-left: 18px; color: #333; }

  @media screen {
    html { background: #e9e9e9; }
    body {
      margin: 32px auto;
      background: #fff;
      box-shadow: 0 0 14px rgba(0, 0, 0, 0.15);
    }
  }
</style>
</head>
<body>
  <header>
    <h1>{{ cv.name }}</h1>
    {% if cv.headline %}<div class="headline">{{ cv.headline }}</div>{% endif %}
    <div class="contact">
      {% if cv.location %}<span>{{ cv.location }}</span>{% endif %}
      {% if cv.email %}<span>{{ cv.email }}</span>{% endif %}
      {% if cv.website %}<span>{{ cv.website }}</span>{% endif %}
      {% for net in cv.social_networks %}<span><strong>{{ net.network }}</strong>/{{ net.username }}</span>{% endfor %}
    </div>
  </header>
  <hr class="divider">

  {% if cv.sections.summary %}
  <h2>Summary</h2>
  {% for para in cv.sections.summary %}
  <p class="summary">{{ para | md_bold | safe }}</p>
  {% endfor %}
  {% endif %}

  {% if cv.sections.experience %}
  <h2>Experience</h2>
  {% for job in cv.sections.experience %}
  <div class="entry">
    {% if job.positions | length == 1 %}
    {% set pos = job.positions[0] %}
    <div class="entry-top">
      <div class="entry-title">{{ pos.position }} <span class="entry-company">— {{ job.company }}</span></div>
      <div class="entry-dates">{{ (pos.start_date, pos.end_date) | date_range }}</div>
    </div>
    <div class="entry-location">{{ job.location }}</div>
    <ul>
      {% for h in pos.highlights %}
      <li>{{ h | md_bold | safe }}</li>
      {% endfor %}
    </ul>
    {% else %}
    <div class="entry-top">
      <div class="entry-title">{{ job.company }}</div>
      <div class="entry-dates">{{ (job.positions[-1].start_date, job.positions[0].end_date) | date_range }}</div>
    </div>
    <div class="entry-location">{{ job.location }}</div>
    {% for pos in job.positions %}
    <div class="position-block">
      <div class="position-top">
        <div class="position-title">{{ pos.position }}</div>
        <div class="position-dates">{{ (pos.start_date, pos.end_date) | date_range }}</div>
      </div>
      <ul>
        {% for h in pos.highlights %}
        <li>{{ h | md_bold | safe }}</li>
        {% endfor %}
      </ul>
    </div>
    {% endfor %}
    {% endif %}
  </div>
  {% endfor %}
  {% endif %}

  {% if cv.sections.education %}
  <h2>Education</h2>
  {% for ed in cv.sections.education %}
  <div class="entry">
    <div class="entry-top">
      <div class="entry-title">{{ ed.institution }}</div>
      <div class="entry-dates">{{ (ed.start_date, ed.end_date) | date_range }}</div>
    </div>
    <div class="entry-location">{{ ed.degree }}, {{ ed.area }} — {{ ed.location }}</div>
  </div>
  {% endfor %}
  {% endif %}

  {% if cv.sections.skills %}
  <h2>Skills</h2>
  <div class="skills">
    {% for s in cv.sections.skills %}
    <div class="skills-row">
      <div class="skills-label">{{ s.label }}</div>
      <div class="skills-details">{{ s.details }}</div>
    </div>
    {% endfor %}
  </div>
  {% endif %}

  {% if cv.sections.awards %}
  <h2>Awards</h2>
  <ul class="awards-list">
    {% for a in cv.sections.awards %}
    <li>{{ a.bullet | md_bold | safe }}</li>
    {% endfor %}
  </ul>
  {% endif %}
</body>
</html>
