<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ cv.name }} - Resume</title>
<meta name="description" content="{{ cv.headline }}">
<link rel="canonical" href="{{ site_url }}/">
<style>
  @page { size: A4; margin: 20mm 22mm; }
  * { box-sizing: border-box; }
  body {
    font-family: 'Georgia', 'Times New Roman', serif;
    color: #1a1a1a;
    font-size: 10.5pt;
    line-height: 1.55;
    margin: 0;
    padding: 40px 48px;
    max-width: 760px;
  }
  header { margin-bottom: 22px; }
  h1 {
    font-family: 'Helvetica Neue', Arial, sans-serif;
    font-weight: 300;
    font-size: 30pt;
    letter-spacing: 0.5px;
    margin: 0;
    color: #111;
  }
  .name-row { display: flex; align-items: baseline; gap: 16px; flex-wrap: wrap; margin: 0 0 6px 0; }
  .name-location {
    font-family: 'Helvetica Neue', Arial, sans-serif;
    font-size: 12pt;
    font-weight: 400;
    color: #888;
  }
  .headline {
    font-family: 'Helvetica Neue', Arial, sans-serif;
    font-size: 11.5pt;
    color: #555;
    margin: 0 0 14px 0;
  }
  .contact {
    font-family: 'Helvetica Neue', Arial, sans-serif;
    font-size: 9.5pt;
    color: #666;
    letter-spacing: 0.3px;
  }
  .contact span { white-space: nowrap; }
  .contact span:not(:last-child)::after { content: " | "; color: #ccc; }
  hr.divider {
    border: none;
    border-top: 1px solid #ddd;
    margin: 18px 0 22px 0;
  }
  h2 {
    font-family: 'Helvetica Neue', Arial, sans-serif;
    font-size: 10pt;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: #8a5a3b;
    display: inline-block;
    border-bottom: 2px solid #b8916d;
    padding-bottom: 4px;
    margin: 0 0 14px 0;
  }
  .block { padding: 16px 0; }
  .block:first-of-type { padding-top: 0; }
  .summary { color: #333; margin: 0; }
  li::marker { color: #b8916d; }
  .entry {
    margin-bottom: 16px;
    display: flex;
    flex-direction: column;
    border-left: 3px solid #b8916d;
    padding-left: 14px;
  }
  .entry.entry-single { break-inside: avoid; }
  .entry.no-border { border-left: none; }
  .entry-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    break-after: avoid;
  }
  .entry-title {
    font-family: 'Helvetica Neue', Arial, sans-serif;
    font-weight: 600;
    font-size: 11pt;
    color: #111;
  }
  .entry-company {
    font-style: italic;
    color: #444;
  }
  .entry-dates {
    font-family: 'Helvetica Neue', Arial, sans-serif;
    font-size: 9.5pt;
    color: #999;
    white-space: nowrap;
    padding-left: 12px;
  }
  .entry-location {
    font-family: 'Helvetica Neue', Arial, sans-serif;
    font-size: 9.5pt;
    color: #999;
    margin-bottom: 6px;
    break-after: avoid;
  }
  ul { margin: 0; padding-left: 18px; color: #333; }
  li { margin-bottom: 4px; }
  .position-block { margin-top: 8px; margin-left: 18px; break-inside: avoid; }
  .position-block:first-of-type { margin-top: 2px; }
  .position-block + .position-block { border-top: 1px solid #eee; padding-top: 8px; }
  .position-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    break-after: avoid;
  }
  .position-title {
    font-family: 'Helvetica Neue', Arial, sans-serif;
    font-weight: 600;
    font-size: 10.2pt;
    color: #222;
  }
  .position-dates {
    font-family: 'Helvetica Neue', Arial, sans-serif;
    font-size: 9pt;
    color: #999;
    white-space: nowrap;
    padding-left: 12px;
  }
  .skills-table { width: 100%; border-collapse: collapse; border: 1px solid #b8916d; }
  .skills-table tr { break-inside: avoid; }
  .skills-table tr:nth-child(even) { background: #f7f1ec; }
  .skills-table td { padding: 8px 12px; vertical-align: top; border: 1px solid #ddd0c4; }
  .skills-label {
    font-family: 'Helvetica Neue', Arial, sans-serif;
    font-weight: 600;
    color: #111;
    width: 150px;
    white-space: nowrap;
  }
  .skills-details { color: #444; }
  .awards-list { margin: 0; padding-left: 18px; color: #333; }

  @media screen {
    html { background: #e9e9e9; }
    body {
      margin: 32px auto;
      background: #fff;
      box-shadow: 0 0 14px rgba(0, 0, 0, 0.15);
    }
  }
</style>
</head>
<body>
  {% include "_switcher.html.j2" %}
  <header>
    <div class="name-row">
      <h1>{{ cv.name }}</h1>
      {% if cv.location %}<span class="name-location">{{ cv.location }}</span>{% endif %}
    </div>
    {% if cv.headline %}<div class="headline">{{ cv.headline }}</div>{% endif %}
    <div class="contact">
      {% if cv.email %}<span>{{ cv.email }}</span>{% endif %}
      {% if cv.website %}<span>{{ cv.website }}</span>{% endif %}
      {% for net in cv.social_networks %}<span><strong>{{ net.network }}:</strong> {{ net.username }}</span>{% endfor %}
    </div>
  </header>
  <hr class="divider">

  {% if cv.sections.summary %}
  <section class="block">
    <h2>Summary</h2>
    {% for para in cv.sections.summary %}
    <p class="summary">{{ para | md_bold | safe }}</p>
    {% endfor %}
  </section>
  {% endif %}

  {% if cv.sections.experience %}
  <section class="block">
  <h2>Experience</h2>
  {% for job in cv.sections.experience %}
  <div class="entry">
    {% if job.positions | length == 1 %}
    {% set pos = job.positions[0] %}
    <div class="entry-top">
      <div class="entry-title">{{ pos.position }} <span class="entry-company">— {{ job.company }}</span></div>
      <div class="entry-dates">{{ (pos.start_date, pos.end_date) | date_range }}</div>
    </div>
    <div class="entry-location">{{ job.location }}</div>
    <ul>
      {% for h in pos.highlights %}
      <li>{{ h | md_bold | safe }}</li>
      {% endfor %}
    </ul>
    {% else %}
    <div class="entry-top">
      <div class="entry-title">{{ job.company }}</div>
      <div class="entry-dates">{{ (job.positions[-1].start_date, job.positions[0].end_date) | date_range }}</div>
    </div>
    <div class="entry-location">{{ job.location }}</div>
    {% for pos in job.positions %}
    <div class="position-block">
      <div class="position-top">
        <div class="position-title">{{ pos.position }}</div>
        <div class="position-dates">{{ (pos.start_date, pos.end_date) | date_range }}</div>
      </div>
      <ul>
        {% for h in pos.highlights %}
        <li>{{ h | md_bold | safe }}</li>
        {% endfor %}
      </ul>
    </div>
    {% endfor %}
    {% endif %}
  </div>
  {% endfor %}
  </section>
  {% endif %}

  {% if cv.sections.education %}
  <section class="block">
  <h2>Education</h2>
  {% for ed in cv.sections.education %}
  <div class="entry entry-single no-border">
    <div class="entry-top">
      <div class="entry-title">{{ ed.institution }}</div>
      <div class="entry-dates">{{ (ed.start_date, ed.end_date) | date_range }}</div>
    </div>
    <div class="entry-location">{{ ed.degree }}, {{ ed.area }} — {{ ed.location }}</div>
  </div>
  {% endfor %}
  </section>
  {% endif %}

  {% if cv.sections.skills %}
  <section class="block">
  <h2>Skills</h2>
  <table class="skills-table">
    {% for s in cv.sections.skills %}
    <tr>
      <td class="skills-label">{{ s.label }}</td>
      <td class="skills-details">{{ s.details }}</td>
    </tr>
    {% endfor %}
  </table>
  </section>
  {% endif %}

  {% if cv.sections.awards %}
  <section class="block">
  <h2>Awards</h2>
  <ul class="awards-list">
    {% for a in cv.sections.awards %}
    <li>{{ a.bullet | md_bold | safe }}</li>
    {% endfor %}
  </ul>
  </section>
  {% endif %}
</body>
</html>
